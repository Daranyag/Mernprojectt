# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Primary)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studysense?retryWrites=true&w=majority

# Local MongoDB Fallback (used if Atlas IP whitelist restricts connection)
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/studysense

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_super_strong_random_secret_at_least_32_chars
JWT_EXPIRE=1d

# Cookie Secret
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string

# Frontend Client URL (For CORS & Credentials)
CLIENT_URL=http://localhost:5173

# Module 8: AI Quiz Generator (Google Gemini API)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
